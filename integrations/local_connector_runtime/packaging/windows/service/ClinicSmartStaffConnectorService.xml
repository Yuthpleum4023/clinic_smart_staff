<service>
  <id>ClinicSmartStaffConnector</id>
  <name>Clinic Smart Staff Connector</name>
  <description>Read-only connector from a clinic source system to Clinic Smart Staff.</description>
  <executable>%BASE%\node\node.exe</executable>
  <arguments>%BASE%\app\bin\connector.js %BASE%\config\connector-config.json</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
